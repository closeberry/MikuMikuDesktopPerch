// Application icon and version information (shown in Explorer and in Task Manager's startup list).
#include <winres.h>

1 ICON "MikuMikuDesktopPerch.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,5,0,0
 PRODUCTVERSION 1,5,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041104b0"
        BEGIN
            VALUE "CompanyName", "closeberry"
            VALUE "FileDescription", "MikuMikuDesktopPerch"
            VALUE "FileVersion", "1.5.0.0"
            VALUE "InternalName", "MikuMikuDesktopPerch"
            VALUE "LegalCopyright", "Copyright (c) 2026 closeberry. MIT License."
            VALUE "OriginalFilename", "MikuMikuDesktopPerch.exe"
            VALUE "ProductName", "MikuMikuDesktopPerch"
            VALUE "ProductVersion", "1.5.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x411, 1200
    END
END

// Built-in idle clips: VMD motions played now and then among the gestures of the standing
// pose. One line each, a name and the file under res\idle (credit the author in README):
//   Stroll IDLECLIP "idle\\stroll.vmd"
// Their labels for the settings (UTF-8 lines: name, tab, Japanese, tab, English):
NAMES IDLECLIPNAMES "idle\\names.txt"

// Built-in window motions (see docs/WindowMotions.md): resting on a window's top edge, or moving
// along it. One line each, a name and the file under res\window; their labels go in the same
// idle\names.txt. None yet:
//   Lean WINDOWCLIP "window\\lean.vmd"

// By Aki (see README): the upper arms swung forward where a forearm met the chest, the eyes'
// side-to-side turn halved, and the bones and morphs of the model they were made on left out.
YAWN IDLECLIP "idle\\yawn.vmd"
HMM IDLECLIP "idle\\hmm.vmd"
SORRY IDLECLIP "idle\\sorry.vmd"
LEAN IDLECLIP "idle\\lean.vmd"

// By Yuno (see README): eased in from the standing pose and back out to it, smoothed over
// time (the corners at linearly interpolated keys gone), one standing off the origin moved
// back onto it, the eyes' side-to-side turn halved, and the bones and morphs of the model
// they were made on left out.
DOGEZA IDLECLIP "idle\\dogeza.vmd"
DOUBLEPEACE IDLECLIP "idle\\doublepeace.vmd"
BALLET IDLECLIP "idle\\ballet.vmd"
LETSGO IDLECLIP "idle\\letsgo.vmd"
EXERCISE IDLECLIP "idle\\exercise.vmd"
LOOKAROUND IDLECLIP "idle\\lookaround.vmd"
FLOAT IDLECLIP "idle\\float.vmd"
KNEEBEND IDLECLIP "idle\\kneebend.vmd"
SPIN IDLECLIP "idle\\spin.vmd"
LISTEN IDLECLIP "idle\\listen.vmd"

// The mahjong tiles' faces (see docs/Mahjong.md): 150x200 each, ten across, the 34 kinds in
// order and then the red fives.
TILES MAHJONGTILES "mahjong\\tiles.png"

// The result screen's brush hand: Yuji Syuku (SIL Open Font License, licenses/YujiSyuku-OFL.txt),
// cut down to the characters the mahjong game writes (tools: fontTools' subset).
BRUSH MAHJONGFONT "mahjong\\brush.ttf"

// The mahjong table's tile sounds (src/MahjongSound.cpp): 44.1 kHz, mono, 16-bit WAV files.
// A tile set down (three of them, taken by turns), softly (hers, appearing in her river) and
// hard (a riichi), drawn, the riichi stick, pon, kan, the tiles dealt.
PLACE1 MAHJONGSOUND "mahjong\\sounds\\place1.wav"
PLACE2 MAHJONGSOUND "mahjong\\sounds\\place2.wav"
PLACE3 MAHJONGSOUND "mahjong\\sounds\\place3.wav"
PLACESOFT MAHJONGSOUND "mahjong\\sounds\\place-soft.wav"
PLACESTRONG MAHJONGSOUND "mahjong\\sounds\\place-strong.wav"
DRAW MAHJONGSOUND "mahjong\\sounds\\draw.wav"
RIICHI MAHJONGSOUND "mahjong\\sounds\\riichi.wav"
PON MAHJONGSOUND "mahjong\\sounds\\pon.wav"
KAN MAHJONGSOUND "mahjong\\sounds\\kan.wav"
DEAL MAHJONGSOUND "mahjong\\sounds\\deal.wav"
